<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Title Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/title_pill"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unpacker by Fahad"
            android:textSize="13sp"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Tab Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:padding="3dp"
        android:background="@drawable/glass_pill">

        <TextView
            android:id="@+id/tabInstalled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_installed"
            android:textSize="12sp"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glass_pill_selected"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tabStorage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_storage"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:fontFamily="sans-serif-medium"
            android:background="@android:color/transparent"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Installed Apps Tab -->
        <LinearLayout
            android:id="@+id/installedTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/glass_search"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textSize="13sp"
                    android:textColorHint="@color/textTertiary"
                    android:textColor="@color/textPrimary"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Section Label -->
            <TextView
                android:id="@+id/sectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="6dp"
                android:textSize="10sp"
                android:textColor="@color/textSecondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <!-- App List -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="true"
                    android:scrollbarThumbVertical="@color/glass" />

                <!-- Loading State -->
                <LinearLayout
                    android:id="@+id/loadingState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/loading_apps"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_apps"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- From Storage Tab -->
        <LinearLayout
            android:id="@+id/storageTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="16dp">

            <!-- APK Empty State -->
            <LinearLayout
                android:id="@+id/apkEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="48dp"
                android:background="@drawable/glass_card"
                android:padding="24dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_upload"
                    android:alpha="0.5"
                    android:contentDescription="Upload" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_apk_selected"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/choose_apk"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/btnPick"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:text="@string/btn_select_apk"
                    android:textSize="12sp"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/glass_button"
                    android:letterSpacing="0.03" />
            </LinearLayout>

            <!-- APK Selected State -->
            <LinearLayout
                android:id="@+id/apkSelectedState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/apkIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/icon_background"
                    android:contentDescription="APK icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp">

                    <TextView
                        android:id="@+id/pickedName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/textPrimary"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="middle" />

                    <TextView
                        android:id="@+id/pickedSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/pickedPackage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnChange"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/btn_change_apk"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/glass_button"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Unpack Button -->
            <TextView
                android:id="@+id/btnUnpack"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/btn_unpack"
                android:textSize="13sp"
                android:textColor="@color/textPrimary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/glass_button"
                android:letterSpacing="0.05"
                android:visibility="gone" />

            <!-- Progress -->
            <LinearLayout
                android:id="@+id/progressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progressDrawable="@drawable/glass_progress"
                    android:max="100" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Result -->
            <LinearLayout
                android:id="@+id/resultSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/resultIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Result" />

                    <TextView
                        android:id="@+id/resultTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="13sp"
                        android:textColor="@color/textPrimary"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/resultMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/unpackResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="10sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="monospace"
                    android:background="@color/surface"
                    android:padding="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/unpackCopyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap the location to copy it"
                    android:textSize="9sp"
                    android:textColor="@color/textSecondary"
                    android:letterSpacing="0.04"
                    android:paddingTop="4dp"
                    android:drawablePadding="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnInstall"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Install APK"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/glass_button"
                    android:letterSpacing="0.05"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Metadata -->
            <LinearLayout
                android:id="@+id/metadataSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APK Information"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <TextView android:id="@+id/metaPackage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaDex" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaNative" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaAbi" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaAppClass" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" android:layout_marginBottom="3dp" />
                <TextView android:id="@+id/metaLauncher" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/textSecondary" android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Protection -->
            <LinearLayout
                android:id="@+id/protectionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protection Layers"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/protectionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Junk -->
            <LinearLayout
                android:id="@+id/junkSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Obfuscation Suspects"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/junkList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Logs -->
            <LinearLayout
                android:id="@+id/logSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/glass_card"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/logToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_expand_more"
                        android:contentDescription="Expand"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Details &amp; Logs"
                        android:textSize="11sp"
                        android:textColor="@color/textSecondary"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/logCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/textTertiary"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="10sp"
                    android:textColor="@color/textSecondary"
                    android:fontFamily="monospace"
                    android:maxLines="30"
                    android:scrollbars="vertical"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
